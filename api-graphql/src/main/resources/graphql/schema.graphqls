type Query {
    post(id: ID!): Post
    posts(keyword: String, memberId: ID, page: Int! = 0, size: Int! = 20): PostPage!
    "Readable by the member themself or an ADMIN only."
    member(id: ID!): Member
}

type Mutation {
    register(input: RegisterInput!): Member!
    login(input: LoginInput!): TokenPayload!
    refresh(refreshToken: String!): TokenPayload!
    createPost(input: PostInput!): Post!
    updatePost(id: ID!, input: PostInput!): Post!
    deletePost(id: ID!): Boolean!
}

"Private profile: only ever returned to its owner or an ADMIN."
type Member {
    id: ID!
    email: String!
    name: String!
    role: String!
}

"Public author view. Deliberately has no email or role, so posts can never leak them."
type Author {
    id: ID!
    name: String!
}

type Post {
    id: ID!
    title: String!
    content: String!
    createdAt: String!
    author: Author!
}

type PostPage {
    items: [Post!]!
    page: Int!
    size: Int!
    total: Int!
}

type TokenPayload {
    accessToken: String!
    refreshToken: String!
}

input RegisterInput {
    email: String!
    password: String!
    name: String!
}

input LoginInput {
    email: String!
    password: String!
}

input PostInput {
    title: String!
    content: String!
}
