# 로컬 개발 전용 샘플입니다. `cp .env.example .env` 로 복사해서 사용하세요.
# .env 는 git에 커밋되지 않습니다(.gitignore). 공유·운영 환경에서는 반드시 다른 값을 쓰세요.
POSTGRES_PASSWORD=changeme123

# JWT 서명 키(32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=

# (선택) 호스트의 5432 포트가 이미 사용 중이면 다른 포트를 지정하세요. 기본값은 5432.
# 바꾸면 앱 실행 전에 DB_URL 도 같은 포트로 맞춰야 합니다. 예: DB_URL=jdbc:postgresql://localhost:55433/example
# POSTGRES_HOST_PORT=5432
